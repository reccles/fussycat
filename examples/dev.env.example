# shellcheck shell=sh
# A dev env file: this machine's settings for the examples. Copy it to
# ~/.config/fussycat/dev.env (or point FUSSYCAT_DEV_ENV at yours);
# examples/lib.sh sources it. It lives outside the repo, so every checkout
# shares it and nothing about your network gets committed.
#
# It holds references, never secrets: a key *command* is fine here, a key
# isn't. Use `: "${VAR:=value}"`, so a variable set in the environment wins.

# Where Ollama runs (default http://localhost:11434), and the model to use.
# It must be an ollama: model: the examples are free, and lib.sh refuses
# anything else.
# : "${FUSSYCAT_OLLAMA_URL:=http://ollama.example:11434}"
# : "${FUSSYCAT_MODEL:=ollama:gpt-oss:20b}"

# A fussycat binary other than this checkout's target/debug, if you mean to
# test one.
# : "${FUSSYCAT_BIN:=$HOME/.local/bin/fussycat}"

# Paid providers. Setting a key command makes the paid parts of providers.sh
# and limits-and-exit-codes.sh run (and cost money), so they're usually left
# commented and exported by hand when wanted. Any command that prints the key
# works, from your password manager for instance:
# export FUSSYCAT_VENICE_KEY_COMMAND='pass show venice/api-key'
# export FUSSYCAT_ANTHROPIC_KEY_COMMAND='op read op://vault/item/credential'
# And the models they use (both default to claude-haiku-5-5):
# export FUSSYCAT_VENICE_MODEL=claude-haiku-5-5
# export FUSSYCAT_ANTHROPIC_MODEL=claude-haiku-5-5
